# Copy this file to keystore.properties in the repo root.
# Never commit keystore.properties.
#
# The real upload keystore should live outside the repository.
# Example:
# storeFile=/Users/<you>/.android/phone-down-release/phone-down-upload.jks

storeFile=/absolute/path/outside/repo/phone-down-upload.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=phone-down-upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
