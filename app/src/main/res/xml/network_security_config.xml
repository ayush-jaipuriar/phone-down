<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">accounts.google.com</domain>
        <domain includeSubdomains="true">www.googleapis.com</domain>
        <domain includeSubdomains="true">android.clients.google.com</domain>
        <pin-set expiration="2027-01-01">
            <!-- Replace with actual certificate pins before release -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
        <!-- Allow fallback to system CAs to prevent outage on certificate rotation -->
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
        <cleartextTrafficPermitted>false</cleartextTrafficPermitted>
    </domain-config>
</network-security-config>
